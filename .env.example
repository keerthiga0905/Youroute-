# RouteMap AI — Environment Configuration Example

# FastAPI Backend & Database
PROJECT_NAME="RouteMap AI — Personal Safety Risk Predictor"
DATABASE_URL="sqlite:///./saferoute.db"

# JWT Authentication & Cryptographic Keys
# Generate a strong key in production via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="routemap_super_secret_jwt_key_change_in_production_2026"
ALGORITHM="HS256"
TOKEN_ISSUER="RouteMap-Auth"
TOKEN_AUDIENCE="RouteMap-App"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5
RESET_TOKEN_EXPIRE_MINUTES=15
RATE_LIMIT_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Google Maps Platform API Key (Restricted to Maps JS API, Places API, Geocoding, Directions API)
GOOGLE_MAPS_API_KEY="AIzaSyYourRestrictedGoogleMapsApiKeyHere"

# OpenWeatherMap API Key (For live weather integration)
WEATHER_API_KEY="your_open_weather_map_api_key_here"

# SMTP Configuration (For Real Email Verification OTP & Password Reset Delivery)
# For Gmail, generate an App Password from your Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_16_character_app_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# Frontend Application Origin
FRONTEND_URL="http://localhost:5173"
LOCATION_REQUEST_EXPIRE_MINUTES=30

# Operational Mode
DEMO_MODE=true
