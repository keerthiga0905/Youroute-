# SafeRoute AI - Environment Configuration Example

# FastAPI Backend Config
PROJECT_NAME="SafeRoute AI - Personal Safety Risk Predictor"
DATABASE_URL="sqlite:///./saferoute.db"
JWT_SECRET="saferoute_super_secret_key_2026_change_in_production"

# Google Maps Platform API Key (Restricted to Maps JS API, Places API, Geocoding, Directions API)
GOOGLE_MAPS_API_KEY="AIzaSyYourRestrictedGoogleMapsApiKeyHere"

# OpenWeatherMap API Key (For live weather integration)
WEATHER_API_KEY="your_open_weather_map_api_key_here"

# Gmail SMTP Configuration (For Secure Email Location Sharing)
# NEVER put real credentials in .env.example
GMAIL_USER="your_gmail_address@gmail.com"
GMAIL_APP_PASSWORD="your_16_character_app_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
FRONTEND_URL="http://localhost:5173"
LOCATION_REQUEST_EXPIRE_MINUTES=30

# Operational Mode
DEMO_MODE=true

